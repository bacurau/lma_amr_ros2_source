<robot name="vehicle_blue">
    <link name="caster">
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <inertia ixx="0.016" ixy="0" ixz="0" iyy="0.016" iyz="0" izz="0.016"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <geometry>
                <sphere radius="0.2"/>
            </geometry>
           <material name="">
                <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <geometry>
                <sphere radius="0.2"/>
            </geometry>
        </collision>
    </link>
    <link name="chassis">
        <inertial>
            <mass value="10.144"/>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <inertia ixx="0.095329" ixy="0" ixz="0" iyy="0.381317" iyz="0" izz="0.476646"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <geometry>
                <box size="2 1 0.5"/>
            </geometry>
            <material name="chassisvisual">
                <texture/>
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <geometry>
                <box size="2 1 0.5"/>
            </geometry>
        </collision>
    </link>
    <link name="left_wheel">
        <inertial>
            <mass value="2"/>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <inertia ixx="0.043333" ixy="0" ixz="0" iyy="0.043333" iyz="0" izz="0.08"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <geometry>
                <cylinder radius="0.4" length="0.2"/>
            </geometry>
            <material name="left_wheelvisual">
                <texture/>
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <geometry>
                <cylinder radius="0.4" length="0.2"/>
            </geometry>
        </collision>
    </link>
    <link name="right_wheel">
        <inertial>
            <mass value="2"/>
            <origin xyz="0 1.66533e-16 0" rpy="0 -0 0"/>
            <inertia ixx="0.043333" ixy="0" ixz="0" iyy="0.043333" iyz="0" izz="0.08"/>
        </inertial>
        <visual>
            <origin xyz="0 3.33067e-16 0" rpy="0 -0 0"/>
            <geometry>
                <cylinder radius="0.4" length="0.2"/>
            </geometry>
            <material name="right_wheelvisual">
                <texture/>
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 3.33067e-16 0" rpy="0 -0 0"/>
            <geometry>
                <cylinder radius="0.4" length="0.2"/>
            </geometry>
        </collision>
    </link>
    <joint name="caster_wheel" type="floating">
        <origin xyz="0.8 0 -0.2" rpy="0 -0 0"/>
        <axis xyz="0 0 0"/>
        <parent link="chassis"/>
        <child link="caster"/>
    </joint>
    <joint name="left_wheel_joint" type="revolute">
        <origin xyz="-0.5 0.6 0" rpy="-1.5707 0 0"/>
        <axis xyz="0 9.63268e-05 1"/>
        <parent link="chassis"/>
        <child link="left_wheel"/>
        <dynamics damping="0" friction="0"/>
        <limit effort="30" velocity="30" lower="-1.79769e+308" upper="1.79769e+308"/>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
        <origin xyz="-0.5 -0.6 0" rpy="-1.5707 0 0"/>
        <axis xyz="0 9.63268e-05 1"/>
        <parent link="chassis"/>
        <child link="right_wheel"/>
        <dynamics damping="0" friction="0"/>
        <limit effort="30" velocity="30" lower="-1.79769e+308" upper="1.79769e+308"/>
    </joint>
</robot>
