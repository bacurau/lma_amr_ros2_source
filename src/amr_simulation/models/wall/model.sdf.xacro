<?xml version="1.0"?>
<sdf version="1.10" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="width" value="1" />
  <xacro:property name="height" value="5" />
  <xacro:macro name="wall" params="suffix length pose">
    <model name='Wall ${suffix}'>
      <link name='box_link'>
        <inertial>
          <inertia>
            <ixx>0.16666</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.16666</iyy>
            <iyz>0</iyz>
            <izz>0.16666</izz>
          </inertia>
          <mass>1</mass>
          <pose>${pose['x']} ${pose['y']} ${pose['z']} ${pose['x_o']} ${pose['y_o']} ${pose['z_o']}</pose>
        </inertial>
        <collision name='box_collision'>
          <geometry>
            <box>
              <size>${width} ${length} ${height}</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode />
            </friction>
            <bounce />
            <contact />
          </surface>
        </collision>
        <visual name='box_visual'>
          <geometry>
            <box>
              <size>${width} ${length} ${height}</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.0 0.15 1</ambient>
            <diffuse>0.1 0.0 0.15 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <pose>${pose['x']} ${pose['y']} ${pose['z']} ${pose['x_o']} ${pose['y_o']} ${pose['z_o']}</pose>
        <enable_wind>false</enable_wind>
      </link>
      <static>true</static>
      <self_collide>false</self_collide>
    </model>
  </xacro:macro>
</sdf>