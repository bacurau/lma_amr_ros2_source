<?xml version="1.0"?>
<sdf version="1.8">
    <!-- I could not find any instance of gazebo or ros using this name, ignore it. -->
    <model name="amr_robot_model_file_name" canonical_link="chassis">
        <!-- Plugins required -->
        <plugin
            filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
        </plugin>


        <link name="chassis">
            <pose relative_to="__model__"> 0 0 0.4 0 0 0 </pose>
            <inertial>
                <mass> 1.14395 </mass>
                <inertia>
                    <ixx> 0.126164 </ixx>
                    <ixy> 0 </ixy>
                    <ixz> 0 </ixz>
                    <iyy> 0.416519 </iyy>
                    <iyz> 0 </iyz>
                    <izz> 0.481014 </izz>
                </inertia>
            </inertial>
            <visual name="visual">
                <geometry>
                    <box>
                        <size> 2.0 1.0 0.5 </size>
                    </box>
                </geometry>
                <material>
                    <ambient> 0.0 0.0 1.0 1 </ambient>
                    <diffuse> 0.0 0.0 1.0 1 </diffuse>
                    <specular> 0.0 0.0 1.0 1 </specular>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <box>
                        <size> 2.0 1.0 0.5 </size>
                    </box>
                </geometry>
            </collision>
        </link>


        <!--
         ______               _      _____          _             __          ___               _
        |  ____|             | |    / ____|        | |            \ \        / / |             | |
        | |__ _ __ ___  _ __ | |_  | |     __ _ ___| |_ ___ _ __   \ \  /\  / /| |__   ___  ___| |
        |  __| '__/ _ \| '_ \| __| | |    / _` / __| __/ _ \ '__|   \ \/  \/ / | '_ \ / _ \/ _ \ |
        | |  | | | (_) | | | | |_  | |___| (_| \__ \ ||  __/ |       \  /\  /  | | | |  __/  __/ |
        |_|  |_|  \___/|_| |_|\__|  \_____\__,_|___/\__\___|_|        \/  \/   |_| |_|\___|\___|_|
        -->
        <frame name="front_caster_wheel_frame" attached_to="chassis">
            <pose> 1 0 -0.2 0 0 0 </pose>
        </frame>
        <link name="front_caster_wheel_link">
            <pose relative_to="front_caster_wheel_frame" />
            <visual name="visual">
                <geometry>
                    <sphere>
                        <radius> 0.2 </radius>
                    </sphere>
                </geometry>
                <material>
                    <ambient> 0.0 1 0.0 1 </ambient>
                    <diffuse> 0.0 1 0.0 1 </diffuse>
                    <specular> 0.0 1 0.0 1 </specular>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <sphere>
                        <radius> 0.2 </radius>
                    </sphere>
                </geometry>
            </collision>
        </link>

        <joint name="front_caster_wheel_wheel" type="ball">
            <parent> chassis </parent>
            <child> front_caster_wheel_link </child>
        </joint>
        <!--
         ____             _       _____          _             __          ___               _
        |  _ \           | |     / ____|        | |            \ \        / / |             | |
        | |_) | __ _  ___| | __ | |     __ _ ___| |_ ___ _ __   \ \  /\  / /| |__   ___  ___| |
        |  _ < / _` |/ __| |/ / | |    / _` / __| __/ _ \ '__|   \ \/  \/ / | '_ \ / _ \/ _ \ |
        | |_) | (_| | (__|   <  | |___| (_| \__ \ ||  __/ |       \  /\  /  | | | |  __/  __/ |
        |____/ \__,_|\___|_|\_\  \_____\__,_|___/\__\___|_|        \/  \/   |_| |_|\___|\___|_|
        -->

        <frame name="back_caster_wheel_frame" attached_to="chassis">
            <pose> -1 0 -0.2 0 0 0 </pose>
        </frame>
        <link name="back_caster_wheel_link">
            <pose relative_to="back_caster_wheel_frame" />
            <visual name="visual">
                <geometry>
                    <sphere>
                        <radius> 0.2 </radius>
                    </sphere>
                </geometry>
                <material>
                    <ambient> 0.0 1 0.0 1 </ambient>
                    <diffuse> 0.0 1 0.0 1 </diffuse>
                    <specular> 0.0 1 0.0 1 </specular>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <sphere>
                        <radius> 0.2 </radius>
                    </sphere>
                </geometry>
            </collision>
        </link>

        <joint name="back_caster_wheel_wheel" type="ball">
            <parent> chassis </parent>
            <child> back_caster_wheel_link </child>
        </joint>

        <!--
         _____       _                      _               _
        |  __ \     (_)                    | |             | |
        | |  | |_ __ ___   _____  __      _| |__   ___  ___| |___
        | |  | | '__| \ \ / / _ \ \ \ /\ / / '_ \ / _ \/ _ \ / __|
        | |__| | |  | |\ V /  __/  \ V  V /| | | |  __/  __/ \__ \
        |_____/|_|  |_| \_/ \___|   \_/\_/ |_| |_|\___|\___|_|___/
        -->

        <!-- The documentation of Gazebo says that continous joint is not
        supported yet, that's why they are revolute -->


        <!-- Left wheel -->
        <link name="left_wheel">
            <pose relative_to="chassis"> 0 0.6 0 -1.5707 0 0 </pose>
            <visual name="visual">
                <geometry>
                    <cylinder>
                        <radius> 0.4 </radius>
                        <length> 0.2 </length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient> 1.0 0.0 0.0 1 </ambient>
                    <diffuse> 1.0 0.0 0.0 1 </diffuse>
                    <specular> 1.0 0.0 0.0 1 </specular>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <cylinder>
                        <radius> 0.4 </radius>
                        <length> 0.2 </length>
                    </cylinder>
                </geometry>
            </collision>
        </link>

        <joint name="left_wheel_joint" type="revolute">
            <pose relative_to="left_wheel" />
            <parent> chassis </parent>
            <child> left_wheel </child>
            <axis>
                <xyz expressed_in="__model__"> 0 1 0 </xyz>
                <limit>
                    <lower> -1.79769e+308 </lower>  <!-- negative infinity -->
                    <upper> 1.79769e+308 </upper>  <!-- positive infinity -->
                </limit>
            </axis>
        </joint>

        <!-- Right wheel -->
        <link name="right_wheel">
            <pose relative_to="chassis"> 0 -0.6 0 -1.5707 0 0 </pose>
            <visual name="visual">
                <geometry>
                    <cylinder>
                        <radius> 0.4 </radius>
                        <length> 0.2 </length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient> 1.0 0.0 0.0 1 </ambient>
                    <diffuse> 1.0 0.0 0.0 1 </diffuse>
                    <specular> 1.0 0.0 0.0 1 </specular>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <cylinder>
                        <radius> 0.4 </radius>
                        <length> 0.2 </length>
                    </cylinder>
                </geometry>
            </collision>
        </link>

        <joint name="right_wheel_joint" type="revolute">
            <pose relative_to="right_wheel" />
            <parent> chassis </parent>
            <child> right_wheel </child>
            <axis>
                <xyz expressed_in="__model__"> 0 1 0 </xyz>
                <limit>
                    <lower> -1.79769e+308 </lower>  <!-- negative infinity -->
                    <upper> 1.79769e+308 </upper>  <!-- positive infinity -->
                </limit>
            </axis>
        </joint>


        <!-- diff drive plugin -->
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <left_joint> left_wheel_joint </left_joint>
            <right_joint> right_wheel_joint </right_joint>
            <wheel_separation> 1.2 </wheel_separation>
            <wheel_radius> 0.4 </wheel_radius>
            <odom_publish_frequency> 1 </odom_publish_frequency>
            <!--
            This plugin subscribes/publishes the following topics:

            topic: Topic (Yes, this is the name) that receives the command
                velocity.
            Optional, if not defined, default value is used.
            Default: /model/{name_of_model}/cmd_vel.

            odom_topic: Topic on which this system will publish odometry
                messages.
            Optional, if not defined, default value is used.
            Default: /model/{name_of_model}/odometry.

            There are other topics, some of which appear to not be documented,
            but they might not be of much use for now.
            -->
        </plugin>
        <!--
          _____
         / ____|
        | (___   ___ _ __  ___  ___  _ __ ___
         \___ \ / _ \ '_ \/ __|/ _ \| '__/ __|
         ____) |  __/ | | \__ \ (_) | |  \__ \
        |_____/ \___|_| |_|___/\___/|_|  |___/
        -->

        <!-- plugin required by the lidars -->
        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine> ogre2 </render_engine>
        </plugin>

        <!--
         ______               _     _      _     _
        |  ____|             | |   | |    (_)   | |
        | |__ _ __ ___  _ __ | |_  | |     _  __| | __ _ _ __
        |  __| '__/ _ \| '_ \| __| | |    | |/ _` |/ _` | '__|
        | |  | | | (_) | | | | |_  | |____| | (_| | (_| | |
        |_|  |_|  \___/|_| |_|\__| |______|_|\__,_|\__,_|_|
        -->

        <frame name="front_lidar_frame" attached_to="front_lidar_link">
            <pose> 0 0 0 0 0 0 </pose>
        </frame>
        <link name="front_lidar_link">
            <pose relative_to="chassis"> 1 1 0 0 0 0 </pose>
            <visual name="visual">
                <geometry>
                    <cylinder>
                        <radius> 0.4 </radius>
                        <length> 0.2 </length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient> 1.0 0.0 0.0 1 </ambient>
                    <diffuse> 1.0 0.0 0.0 1 </diffuse>
                    <specular> 1.0 0.0 0.0 1 </specular>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <cylinder>
                        <radius> 0.4 </radius>
                        <length> 0.2 </length>
                    </cylinder>
                </geometry>
            </collision>
            <sensor name="front_lidar_sensor" type="gpu_lidar">
                <pose relative_to="front_lidar_frame"> 0 0 0 0
                    0 0 </pose>
                <topic> /model/amr_robot_model_name/front_lidar </topic>
                <gz_frame_id>amr_robot_model_name/front_lidar_link</gz_frame_id>
                <update_rate> 10 </update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples> 180 </samples>
                            <resolution> 1 </resolution>
                            <min_angle> -3.1415 </min_angle>
                            <max_angle> 3.1415 </max_angle>
                        </horizontal>
                        <vertical>
                            <samples> 1 </samples>
                            <resolution> 0.01 </resolution>
                            <min_angle> 0 </min_angle>
                            <max_angle> 0 </max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min> 0.08 </min>
                        <max> 10.0 </max>
                        <resolution> 0.01 </resolution>
                    </range>
                </ray>
                <always_on> 1 </always_on>
                <visualize> true </visualize>
            </sensor>
        </link>

        <joint name="front_lidar_joint" type="fixed">
            <pose relative_to="front_lidar_link" />
            <parent> chassis </parent>
            <child> front_lidar_link </child>
        </joint>

        <!--
         ____             _      _      _     _
        |  _ \           | |    | |    (_)   | |
        | |_) | __ _  ___| | __ | |     _  __| | __ _ _ __
        |  _ < / _` |/ __| |/ / | |    | |/ _` |/ _` | '__|
        | |_) | (_| | (__|   <  | |____| | (_| | (_| | |
        |____/ \__,_|\___|_|\_\ |______|_|\__,_|\__,_|_|
        -->

        <frame name="back_lidar_frame" attached_to="back_lidar_link">
            <pose> 0 0 0 0 0 0 </pose>
        </frame>
        <link name="back_lidar_link">
            <pose relative_to="chassis"> -1 -1 0 0 0 0 </pose>
            <visual name="visual">
                <geometry>
                    <cylinder>
                        <radius> 0.4 </radius>
                        <length> 0.2 </length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient> 1.0 0.0 0.0 1 </ambient>
                    <diffuse> 1.0 0.0 0.0 1 </diffuse>
                    <specular> 1.0 0.0 0.0 1 </specular>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <cylinder>
                        <radius> 0.4 </radius>
                        <length> 0.2 </length>
                    </cylinder>
                </geometry>
            </collision>
            <sensor name="back_lidar_sensor" type="gpu_lidar">
                <pose relative_to="back_lidar_frame"> 0 0 0 0
                    0 0 </pose>
                <topic> /model/amr_robot_model_name/back_lidar </topic>
                <gz_frame_id> amr_robot_model_name/back_lidar_link </gz_frame_id>
                <update_rate> 10 </update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples> 640 </samples>
                            <resolution> 1 </resolution>
                            <min_angle> -1.396263 </min_angle>
                            <max_angle> 1.396263 </max_angle>
                        </horizontal>
                        <vertical>
                            <samples> 1 </samples>
                            <resolution> 0.01 </resolution>
                            <min_angle> 0 </min_angle>
                            <max_angle> 0 </max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min> 0.08 </min>
                        <max> 10.0 </max>
                        <resolution> 0.01 </resolution>
                    </range>
                </ray>
                <always_on> 1 </always_on>
                <visualize> true </visualize>
            </sensor>
        </link>

        <joint name="back_lidar_joint" type="fixed">
            <pose relative_to="back_lidar_link" />
            <parent> chassis </parent>
            <child> back_lidar_link </child>
        </joint>

        <!--
          _____ __  __ _    _
         |_   _|  \/  | |  | |
           | | | \  / | |  | |
           | | | |\/| | |  | |
          _| |_| |  | | |__| |
        |_____|_|  |_|\____/
        -->
        <frame name="imu_frame" attached_to="imu_link">
            <pose> 0 0 0 0 0 0 </pose>
        </frame>
        <joint name="imu_joint" type="fixed">
            <pose relative_to="imu_link" />
            <parent> chassis </parent>
            <child> imu_link </child>
        </joint>
        <link name="imu_link">
            <pose relative_to="chassis"> 0 0 1 0 0 0 </pose>
            <visual name="visual">
                <geometry>
                    <box>
                        <size> 0.1 0.1 0.1 </size>
                    </box>
                </geometry>
                <material>
                    <ambient> 0.0 0.0 1.0 1 </ambient>
                    <diffuse> 0.0 0.0 1.0 1 </diffuse>
                    <specular> 0.0 0.0 1.0 1 </specular>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <box>
                        <size> 0.1 0.1 0.1 </size>
                    </box>
                </geometry>
            </collision>

            <sensor name="imu_sensor" type="imu">
                <always_on> 1 </always_on>
                <update_rate> 1 </update_rate>
                <visualize> true </visualize>
                <topic> /model/amr_robot_model_name/imu </topic>
            </sensor>
        </link>

        <!-- TODO understand this, what is the difference from the cmd_vel plugin, and if that can
        specify the frame, if possible we should remove this -->
        <plugin
            filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
            <odom_frame>amr_robot_model_name/odom</odom_frame>
            <robot_base_frame>amr_robot_model_name</robot_base_frame>
        </plugin>

        <plugin
            filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <static_publisher>true</static_publisher>
            <static_update_frequency>1</static_update_frequency>
        </plugin>

        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
        </plugin>
    </model>
</sdf>