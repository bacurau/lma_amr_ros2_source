      <!--Front Velodyne-->
      <sensor name="sensor_ray_front" type="gpu_lidar">
        <!-- <pose>0.7517 0.46465 0.23012 0 -0 3.1415926</pose> -->
        <!--pose>0.75482 0.46497 0.25657 0 -0 3.1415926</pose-->
        <pose>0.743 0.483 0.25657 0 -0 3.1415926</pose>
        <lidar>
          <scan>
            <horizontal>
              <samples>200</samples>
              <resolution>1.0</resolution>
              <!-- <min_angle>-1.57</min_angle>
              <max_angle>3.14</max_angle> -->
              <min_angle>1.57079</min_angle>
              <max_angle>6.2831</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.40</min>
            <max>20.0</max>
          </range>
        </lidar>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>20.0</update_rate>
        <topic>scan_front</topic>
        <gz_frame_id>Velodyne_Front_Left_D_Link</gz_frame_id>
      </sensor>

