<?xml version="1.0"?>
<sdf version="1.10">
    <world name="default">
        <!-- ===================================================== -->
        <!-- Plugins needed for the simulation                     -->
        <!-- Gazebo uses system plugins to enable core features   -->
        <!-- ===================================================== -->

        <!-- Physics engine: enables dynamics simulation
     (gravity, collisions, wheel motion, forces) -->
        <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics" />

        <!-- User commands: allows external commands such as
     spawning or deleting entities from ROS or CLI -->
        <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands" />

        <!-- Scene broadcaster: sends simulation updates to
     the GUI so objects move correctly in the viewer -->
        <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster" />

        <!-- Sensors system: enables simulated sensors such as
     LiDAR, cameras, IMU, etc. Without this plugin
     sensors exist but do not produce data -->
        <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <!-- Rendering engine used by sensors.
       "ogre2" is standard but WSL2 often works better with "ogre". -->
            <render_engine>ogre</render_engine>
        </plugin>

        <!-- Sun -->
        <include>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
        </include>

        <model name="white_floor">
            <static>true</static>
            <pose>0 0 0 0 0 0</pose>

            <link name="floor_link">

                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>150 150</size>
                        </plane>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>150 150</size>
                        </plane>
                    </geometry>

                    <material>
                       <ambient>0.6 0.3 0.1 1</ambient>
                       <diffuse>0.6 0.3 0.1 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>

                </visual>

            </link>
        </model>


        <include>
            <name>Wall</name>
            <uri>model://wall</uri>
            <pose>62.5 0 2.5 0 0 0</pose>
        </include>

        <include>
            <name>Wall2</name>
            <uri>model://wall</uri>
            <pose>0 67.5 2.5 0 0 -1.5708</pose>
        </include>

        <include>
            <name>Wall3</name>
            <uri>model://wall</uri>
            <pose>0 -67.5 2.5 0 0 1.5708</pose>
        </include>

        <include>
            <name>Wall4</name>
            <uri>model://wall</uri>
            <pose>-62.5 0 2.5 0 0 0</pose>
        </include>




        <include>
            <name>Obstacle Scenario</name>
            <uri>model://obstacle_scenario</uri>
            <pose>0 0 0 0 0 0</pose>
        </include>
        <include>
            <name>Obstacle Scenario2</name>
            <uri>model://obstacle_scenario</uri>
            <pose>30 0 0 0 0 0</pose>
        </include>

        <include>
            <name>Obstacle Scenario3</name>
            <uri>model://obstacle_scenario</uri>
            <pose>0 30 0 0 0 0</pose>
        </include>

        <include>
            <name>Obstacle Scenario4</name>
            <uri>model://obstacle_scenario</uri>
            <pose>0 -30 0 0 0 0</pose>
        </include>

        <include>
            <name>Obstacle Scenario5</name>
            <uri>model://obstacle_scenario</uri>
            <pose>-30 0 0 0 0 0</pose>
        </include>

        <include>
            <name>Obstacle Scenario6</name>
            <uri>model://obstacle_scenario</uri>
            <pose>-25 -25 0 0 0 10</pose>
        </include>

        <include>
            <name>Obstacle Scenario7</name>
            <uri>model://obstacle_scenario</uri>
            <pose> 25 25 0 0 0 -10</pose>
        </include>

        <include>
            <name>Obstacle Scenario8</name>
            <uri>model://obstacle_scenario</uri>
            <pose>-25 -25 0 0 0 10</pose>
        </include>

        <include>
            <name>Obstacle Scenario9</name>
            <uri>model://obstacle_scenario</uri>
            <pose> 25 -25 0 0 0 -10</pose>
        </include>

        <include>
            <name>Obstacle Scenario10</name>
            <uri>model://obstacle_scenario</uri>
            <pose> -25 25 0 0 0 10</pose>
        </include>


        <!-- X Y Z Roll Pitch Yaw -->
        <!-- <include>
            <name>Vehicle_blue</name>
            <uri>model://vehicle_blue</uri>
            <pose>2 4 0.05 0 0 0</pose> 
        </include> -->


        <include>
            <name>X1_Config_5</name>
            <uri>model://x1</uri>
            <pose>2 4 0.05 0 0 0</pose> <!-- X Y Z Roll Pitch Yaw -->
        </include>

    </world>
</sdf>